    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>deb17400-e79d-41f7-9778-18d46bc260a8</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
